node_modules/
*.log
.DS_Store
Thumbs.db

# icon build intermediates (regenerate with: python tools/build-icon.py)
_icon-build/

# The 1 MB source PNG is only the build input for client/niang-sleep.webp, which is
# what actually ships. Keep the repo light; anyone can swap in their own PNG and run
# tools/build-icon.py + tools/embed-icon.cjs.
client/niang-sleep.png

# local backups taken before hot-deploying into the profile
_backup-*/
*.bak-*

# testbed: FakeDsh.exe is a local copy of node.exe (see testbed/README.md), and each run
# writes its log/status next to the scripts
testbed/FakeDsh.exe
testbed/*.json
